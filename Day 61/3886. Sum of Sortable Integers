import java.util.*;

class Solution {
    public int sortableIntegers(int[] nums) {
        int n = nums.length;
        int[] sortedNums = nums.clone();
        Arrays.sort(sortedNums);

        // If nums is already sorted, every divisor of n is sortable
        boolean alreadySorted = true;
        for (int i = 0; i < n; i++) {
            if (nums[i] != sortedNums[i]) {
                alreadySorted = false;
                break;
            }
        }

        // Find all divisors of n
        List<Integer> divisors = new ArrayList<>();
        for (int d = 1; (long) d * d <= n; d++) {
            if (n % d == 0) {
                divisors.add(d);
                if (d * d != n) {
                    divisors.add(n / d);
                }
            }
        }

        if (alreadySorted) {
            int total = 0;
            for (int k : divisors) {
                total += k;
            }
            return total;
        }

        int ans = 0;
        int[] lps = new int[n + 1];

        for (int k : divisors) {
            if (canSortWithK(nums, sortedNums, n, k, lps)) {
                ans += k;
            }
        }

        return ans;
    }

    private boolean canSortWithK(int[] nums, int[] sortedNums, int n, int k, int[] lps) {
        if (k == 1) {
            return false;
        }

        // Each block of length k in nums must be a cyclic rotation
        // of the corresponding block in sortedNums
        for (int start = 0; start < n; start += k) {
            if (!isCyclicRotation(nums, sortedNums, start, k, lps)) {
                return false;
            }
        }
        return true;
    }

    private boolean isCyclicRotation(int[] A, int[] B, int start, int k, int[] lps) {
        // Step 1: Precompute KMP LPS array for pattern B[start ... start+k-1]
        int len = 0;
        lps[0] = 0;
        int i = 1;
        while (i < k) {
            if (B[start + i] == B[start + len]) {
                len++;
                lps[i] = len;
                i++;
            } else {
                if (len != 0) {
                    len = lps[len - 1];
                } else {
                    lps[i] = 0;
                    i++;
                }
            }
        }

        // Step 2: Search pattern B in virtual text A + A (length 2*k - 1)
        int textIdx = 0;
        int patternIdx = 0;
        int maxTextLen = 2 * k - 1;

        while (textIdx < maxTextLen) {
            int currentVal = A[start + (textIdx % k)];
            int patternVal = B[start + patternIdx];

            if (currentVal == patternVal) {
                textIdx++;
                patternIdx++;
            }

            if (patternIdx == k) {
                return true;
            } else if (textIdx < maxTextLen && A[start + (textIdx % k)] != B[start + patternIdx]) {
                if (patternIdx != 0) {
                    patternIdx = lps[patternIdx - 1];
                } else {
                    textIdx++;
                }
            }
        }

        return false;
    }
}

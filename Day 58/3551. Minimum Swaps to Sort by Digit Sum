import java.util.Arrays;

class Solution {
    public int minSwaps(int[] nums) {
        int n = nums.length;
        
        // Element class to store value, digit sum, and original index
        Element[] arr = new Element[n];
        for (int i = 0; i < n; i++) {
            arr[i] = new Element(nums[i], getDigitSum(nums[i]), i);
        }
        
        // Sort based on the custom criteria
        Arrays.sort(arr, (a, b) -> {
            if (a.sum != b.sum) {
                return Integer.compare(a.sum, b.sum);
            }
            return Integer.compare(a.val, b.val);
        });
        
        // Count the number of disjoint cycles
        boolean[] visited = new boolean[n];
        int cycles = 0;
        
        for (int i = 0; i < n; i++) {
            // If element is already in the right cycle or visited
            if (visited[i] || arr[i].originalIndex == i) {
                if (arr[i].originalIndex == i && !visited[i]) {
                    cycles++;
                    visited[i] = true;
                }
                continue;
            }
            
            // Traverse the cycle
            int curr = i;
            while (!visited[curr]) {
                visited[curr] = true;
                curr = arr[curr].originalIndex;
            }
            cycles++;
        }
        
        return n - cycles;
    }
    
    private int getDigitSum(int num) {
        int sum = 0;
        while (num > 0) {
            sum += num % 10;
            num /= 10;
        }
        return sum;
    }
    
    private static class Element {
        int val;
        int sum;
        int originalIndex;
        
        Element(int val, int sum, int originalIndex) {
            this.val = val;
            this.sum = sum;
            this.originalIndex = originalIndex;
        }
    }
}

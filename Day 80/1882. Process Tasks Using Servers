import java.util.PriorityQueue;

public class Solution {
    public int[] assignTasks(int[] servers, int[] tasks) {
        int n = servers.length;
        int m = tasks.length;
        int[] ans = new int[m];

        // Free servers heap: ordered by weight, then by index
        // Element: int[]{weight, index}
        PriorityQueue<int[]> freeServers = new PriorityQueue<>((a, b) -> {
            if (a[0] != b[0]) {
                return Integer.compare(a[0], b[0]);
            }
            return Integer.compare(a[1], b[1]);
        });

        // Initialize free servers
        for (int i = 0; i < n; i++) {
            freeServers.offer(new int[]{servers[i], i});
        }

        // Busy servers heap: ordered by freeTime, then by weight, then by index
        // Element: long[]{freeTime, weight, index}
        // Using long for freeTime to prevent overflow
        PriorityQueue<long[]> busyServers = new PriorityQueue<>((a, b) -> {
            if (a[0] != b[0]) {
                return Long.compare(a[0], b[0]);
            }
            if (a[1] != b[1]) {
                return Long.compare(a[1], b[1]);
            }
            return Long.compare(a[2], b[2]);
        });

        long currentTime = 0;

        for (int j = 0; j < m; j++) {
            // Task j arrives at second j
            currentTime = Math.max(currentTime, j);

            // If no servers are currently available, fast-forward time
            if (freeServers.isEmpty()) {
                currentTime = Math.max(currentTime, busyServers.peek()[0]);
            }

            // Release all servers that finish on or before currentTime
            while (!busyServers.isEmpty() && busyServers.peek()[0] <= currentTime) {
                long[] server = busyServers.poll();
                freeServers.offer(new int[]{(int) server[1], (int) server[2]});
            }

            // Assign task j to the best available server
            int[] bestServer = freeServers.poll();
            int weight = bestServer[0];
            int index = bestServer[1];

            ans[j] = index;

            // Mark the server as busy until currentTime + tasks[j]
            busyServers.offer(new long[]{currentTime + tasks[j], weight, index});
        }

        return ans;
    }
}

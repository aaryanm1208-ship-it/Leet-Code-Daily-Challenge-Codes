import java.util.*;

public class Solution {
    // Helper class to maintain median and deviations in a sliding window
    static class SlidingMedianCost {
        private final int x;
        private final PriorityQueue<Integer> left;  // Max-heap
        private final PriorityQueue<Integer> right; // Min-heap
        private final Map<Integer, Integer> delayed;
        private int leftSize = 0;
        private int rightSize = 0;
        private long leftSum = 0;
        private long rightSum = 0;

        public SlidingMedianCost(int x) {
            this.x = x;
            this.left = new PriorityQueue<>(Collections.reverseOrder());
            this.right = new PriorityQueue<>();
            this.delayed = new HashMap<>();
        }

        public void add(int num) {
            if (left.isEmpty() || num <= left.peek()) {
                left.offer(num);
                leftSum += num;
                leftSize++;
            } else {
                right.offer(num);
                rightSum += num;
                rightSize++;
            }
            rebalance();
        }

        public void remove(int num) {
            delayed.put(num, delayed.getOrDefault(num, 0) + 1);
            if (!left.isEmpty() && num <= left.peek()) {
                leftSum -= num;
                leftSize--;
                if (num == left.peek()) {
                    prune(left);
                }
            } else {
                rightSum -= num;
                rightSize--;
                if (!right.isEmpty() && num == right.peek()) {
                    prune(right);
                }
            }
            rebalance();
        }

        public long getCost() {
            int median = left.peek();
            if (x % 2 == 1) {
                // Median is in left heap
                return rightSum - (leftSum - median);
            } else {
                return rightSum - leftSum;
            }
        }

        private void prune(PriorityQueue<Integer> heap) {
            while (!heap.isEmpty() && delayed.getOrDefault(heap.peek(), 0) > 0) {
                int top = heap.poll();
                delayed.put(top, delayed.get(top) - 1);
            }
        }

        private void rebalance() {
            int targetLeftSize = (x + 1) / 2;
            
            // If left has more elements than needed
            while (leftSize > targetLeftSize) {
                int val = left.poll();
                leftSum -= val;
                leftSize--;
                right.offer(val);
                rightSum += val;
                rightSize++;
                prune(left);
            }
            // If left has fewer elements than needed
            while (leftSize < targetLeftSize && rightSize > 0) {
                int val = right.poll();
                rightSum -= val;
                rightSize--;
                left.offer(val);
                leftSum += val;
                leftSize++;
                prune(right);
            }
            prune(left);
            prune(right);
        }
    }

    public long minOperations(int[] nums, int x, int k) {
        int n = nums.length;
        long[] cost = new long[n + 1];

        // Step 1: Precompute cost for each window of length x
        SlidingMedianCost window = new SlidingMedianCost(x);
        for (int i = 0; i < n; i++) {
            window.add(nums[i]);
            if (i >= x) {
                window.remove(nums[i - x]);
            }
            if (i >= x - 1) {
                cost[i + 1] = window.getCost();
            }
        }

        // Step 2: DP to find minimum cost of k non-overlapping intervals
        // dp[j][i] = min cost to select j intervals from nums[0 ... i-1]
        // Since k <= 15, we can use 1D arrays to optimize space
        long INF = (long) 1e18;
        long[] prev = new long[n + 1];

        for (int j = 1; j <= k; j++) {
            long[] curr = new long[n + 1];
            Arrays.fill(curr, INF);

            for (int i = j * x; i <= n; i++) {
                // Option 1: Do not pick an interval ending at i
                curr[i] = curr[i - 1];

                // Option 2: Pick interval ending at i (covering nums[i-x ... i-1])
                if (prev[i - x] != INF) {
                    curr[i] = Math.min(curr[i], prev[i - x] + cost[i]);
                }
            }
            prev = curr;
        }

        return prev[n];
    }
}

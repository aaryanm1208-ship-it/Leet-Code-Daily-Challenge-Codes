class Solution {
    public int minAddToMakeValid(String s) {
        int openNeeded = 0;
        int insertions = 0;

        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '(') {
                openNeeded++;
            } else {
                if (openNeeded > 0) {
                    openNeeded--;
                } else {
                    insertions++;
                }
            }
        }

        return insertions + openNeeded;
    }
}

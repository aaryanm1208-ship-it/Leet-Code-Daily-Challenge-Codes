import java.util.HashMap;
import java.util.Map;

class Solution {
    public int maxNumberOfFamilies(int n, int[][] reservedSeats) {
        // Map to store row -> bitmask of reserved seats (focusing on seats 2 to 9)
        Map<Integer, Integer> rowReservations = new HashMap<>();

        for (int[] seat : reservedSeats) {
            int row = seat[0];
            int col = seat[1];
            
            // Only seats 2 through 9 matter for 4-person blocks
            if (col >= 2 && col <= 9) {
                rowReservations.put(row, rowReservations.getOrDefault(row, 0) | (1 << col));
            }
        }

        // Each completely empty row can accommodate 2 families
        int maxFamilies = (n - rowReservations.size()) * 2;

        // Bitmasks for the 3 valid group patterns:
        // Left:   seats 2, 3, 4, 5 -> (1<<2 | 1<<3 | 1<<4 | 1<<5) = 0b0000111100 = 60
        // Right:  seats 6, 7, 8, 9 -> (1<<6 | 1<<7 | 1<<8 | 1<<9) = 0b1111000000 = 960
        // Middle: seats 4, 5, 6, 7 -> (1<<4 | 1<<5 | 1<<6 | 1<<7) = 0b0011110000 = 240
        int leftMask = (1 << 2) | (1 << 3) | (1 << 4) | (1 << 5);
        int rightMask = (1 << 6) | (1 << 7) | (1 << 8) | (1 << 9);
        int middleMask = (1 << 4) | (1 << 5) | (1 << 6) | (1 << 7);

        for (int mask : rowReservations.values()) {
            boolean canFitLeft = (mask & leftMask) == 0;
            boolean canFitRight = (mask & rightMask) == 0;
            boolean canFitMiddle = (mask & middleMask) == 0;

            if (canFitLeft && canFitRight) {
                maxFamilies += 2;
            } else if (canFitLeft || canFitRight || canFitMiddle) {
                maxFamilies += 1;
            }
        }

        return maxFamilies;
    }
}

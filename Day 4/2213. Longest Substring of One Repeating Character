class Solution {
    struct Node {
        int len;
        int prefix;
        int suffix;
        int best;
        char leftChar;
        char rightChar;

        Node() {}

        Node(int len, int prefix, int suffix, int best,
             char leftChar, char rightChar) {
            this->len = len;
            this->prefix = prefix;
            this->suffix = suffix;
            this->best = best;
            this->leftChar = leftChar;
            this->rightChar = rightChar;
        }
    };

    vector<Node> tree;
    string arr;

    Node merge(Node a, Node b) {
        Node res;

        res.len = a.len + b.len;
        res.leftChar = a.leftChar;
        res.rightChar = b.rightChar;

        res.prefix = a.prefix;
        res.suffix = b.suffix;

        res.best = max(a.best, b.best);

        if (a.rightChar == b.leftChar) {

            res.best = max(res.best, a.suffix + b.prefix);

            if (a.prefix == a.len)
                res.prefix = a.len + b.prefix;

            if (b.suffix == b.len)
                res.suffix = b.len + a.suffix;
        }

        return res;
    }

    void build(int node, int l, int r) {
        if (l == r) {
            tree[node] = Node(1, 1, 1, 1, arr[l], arr[l]);
            return;
        }

        int mid = (l + r) / 2;

        build(node * 2, l, mid);
        build(node * 2 + 1, mid + 1, r);

        tree[node] = merge(tree[node * 2], tree[node * 2 + 1]);
    }

    void update(int node, int l, int r, int index) {
        if (l == r) {
            tree[node] = Node(1, 1, 1, 1, arr[l], arr[l]);
            return;
        }

        int mid = (l + r) / 2;

        if (index <= mid)
            update(node * 2, l, mid, index);
        else
            update(node * 2 + 1, mid + 1, r, index);

        tree[node] = merge(tree[node * 2], tree[node * 2 + 1]);
    }

public:
    vector<int> longestRepeating(string s, string queryCharacters,
                                 vector<int>& queryIndices) {

        arr = s;

        int n = s.length();
        int k = queryIndices.size();

        tree.resize(4 * n);

        build(1, 0, n - 1);

        vector<int> ans(k);

        for (int i = 0; i < k; i++) {

            int index = queryIndices[i];
            char ch = queryCharacters[i];

            arr[index] = ch;

            update(1, 0, n - 1, index);

            ans[i] = tree[1].best;
        }

        return ans;
    }
};

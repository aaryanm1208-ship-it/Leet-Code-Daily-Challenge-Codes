import java.util.Arrays;

class Solution {
    public int maxSelectedElements(int[] nums) {
        // Sort the array to process elements in non-decreasing order
        Arrays.sort(nums);
        
        // Max value in nums is 10^6, and we can increment it by 1 to 10^6 + 1
        int maxVal = nums[nums.length - 1];
        int[] dp = new int[maxVal + 2];
        
        int maxConsecutive = 0;
        
        for (int x : nums) {
            // Option 1: Increment x to x + 1 (must be computed before updating dp[x])
            dp[x + 1] = dp[x] + 1;
            
            // Option 2: Keep x unchanged
            dp[x] = dp[x - 1] + 1;
            
            // Track the overall maximum length found so far
            maxConsecutive = Math.max(maxConsecutive, Math.max(dp[x], dp[x + 1]));
        }
        
        return maxConsecutive;
    }
}

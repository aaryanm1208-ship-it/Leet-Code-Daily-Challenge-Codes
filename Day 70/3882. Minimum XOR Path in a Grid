class Solution {
    public int minCost(int[][] grid) {
        int m = grid.length;
        int n = grid[0].length;
        final int MAX_VAL = 1024;

        boolean[][] dp = new boolean[n][MAX_VAL];
        dp[0][grid[0][0]] = true;

        // First row: only reachable from the left
        for (int j = 1; j < n; j++) {
            int val = grid[0][j];
            for (int v = 0; v < MAX_VAL; v++) {
                if (dp[j - 1][v]) {
                    dp[j][v ^ val] = true;
                }
            }
        }

        for (int i = 1; i < m; i++) {
            boolean[][] nextDp = new boolean[n][MAX_VAL];

            // First column: only reachable from above
            int firstVal = grid[i][0];
            for (int v = 0; v < MAX_VAL; v++) {
                if (dp[0][v]) {
                    nextDp[0][v ^ firstVal] = true;
                }
            }

            // Other cells: reachable from above (dp) or from the left (nextDp)
            for (int j = 1; j < n; j++) {
                int val = grid[i][j];
                for (int v = 0; v < MAX_VAL; v++) {
                    if (dp[j][v] || nextDp[j - 1][v]) {
                        nextDp[j][v ^ val] = true;
                    }
                }
            }

            dp = nextDp;
        }

        for (int v = 0; v < MAX_VAL; v++) {
            if (dp[n - 1][v]) {
                return v;
            }
        }
        return 0;
    }
}

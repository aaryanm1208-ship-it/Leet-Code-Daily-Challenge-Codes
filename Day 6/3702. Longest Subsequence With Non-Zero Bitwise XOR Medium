class Solution {
    public int longestSubsequence(int[] nums) {
        int totalXor = 0;
        boolean hasNonZero = false;

        for (int x : nums) {
            totalXor ^= x;
            if (x != 0) {
                hasNonZero = true;
            }
        }

        // If the total XOR is already non-zero, take all elements
        if (totalXor != 0) {
            return nums.length;
        }

        // If total XOR is 0, but there is at least one non-zero element,
        // removing that element gives a non-zero XOR sum of length n - 1.
        if (hasNonZero) {
            return nums.length - 1;
        }

        // All elements are 0
        return 0;
    }
}

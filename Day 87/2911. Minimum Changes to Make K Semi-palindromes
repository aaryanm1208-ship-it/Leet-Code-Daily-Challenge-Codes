import java.util.*;

class Solution {
    public int minimumChanges(String s, int k) {
        int n = s.length();
        char[] chars = s.toCharArray();
        
        // 1. Precompute proper divisors for every possible substring length L
        List<Integer>[] divisors = new ArrayList[n + 1];
        for (int L = 2; L <= n; L++) {
            divisors[L] = new ArrayList<>();
            for (int d = 1; d <= L / 2; d++) {
                if (L % d == 0) {
                    divisors[L].add(d);
                }
            }
        }
        
        // 2. Precompute cost[i][j]: min changes to make s[i..j] a semi-palindrome
        int INF = 1_000_000_000;
        int[][] cost = new int[n][n];
        for (int[] row : cost) {
            Arrays.fill(row, INF);
        }
        
        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                int L = j - i + 1;
                int minChanges = INF;
                
                for (int d : divisors[L]) {
                    int changes = 0;
                    int groupLen = L / d;
                    
                    for (int r = 0; r < d; r++) {
                        int left = 0, right = groupLen - 1;
                        while (left < right) {
                            if (chars[i + r + left * d] != chars[i + r + right * d]) {
                                changes++;
                            }
                            left++;
                            right--;
                        }
                    }
                    minChanges = Math.min(minChanges, changes);
                }
                cost[i][j] = minChanges;
            }
        }
        
        // 3. DP to partition s[0..j-1] into p semi-palindromes
        int[][] dp = new int[k + 1][n + 1];
        for (int[] row : dp) {
            Arrays.fill(row, INF);
        }
        dp[0][0] = 0;
        
        for (int p = 1; p <= k; p++) {
            for (int j = 2 * p; j <= n; j++) {
                for (int i = 2 * (p - 1); i <= j - 2; i++) {
                    if (dp[p - 1][i] + cost[i][j - 1] < dp[p][j]) {
                        dp[p][j] = dp[p - 1][i] + cost[i][j - 1];
                    }
                }
            }
        }
        
        return dp[k][n];
    }
}

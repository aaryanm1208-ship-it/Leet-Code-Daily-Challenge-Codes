import java.util.Arrays;
import java.util.Comparator;

class Solution {
    public int[] countServers(int n, int[][] logs, int x, int[] queries) {
        int m = queries.length;
        int[][] sortedQueries = new int[m][2];
        for (int i = 0; i < m; i++) {
            sortedQueries[i][0] = queries[i];
            sortedQueries[i][1] = i; // Store original index
        }

        // Sort logs by timestamp
        Arrays.sort(logs, Comparator.comparingInt(a -> a[1]));

        // Sort queries by query timestamp
        Arrays.sort(sortedQueries, Comparator.comparingInt(a -> a[0]));

        int[] ans = new int[m];
        int[] serverCount = new int[n + 1];
        int activeServers = 0;

        int left = 0;
        int right = 0;
        int totalLogs = logs.length;

        for (int[] query : sortedQueries) {
            int qTime = query[0];
            int origIdx = query[1];

            int windowStart = qTime - x;
            int windowEnd = qTime;

            // Expand right boundary: add logs where time <= windowEnd
            while (right < totalLogs && logs[right][1] <= windowEnd) {
                int serverId = logs[right][0];
                if (serverCount[serverId] == 0) {
                    activeServers++;
                }
                serverCount[serverId]++;
                right++;
            }

            // Shrink left boundary: remove logs where time < windowStart
            while (left < totalLogs && logs[left][1] < windowStart) {
                int serverId = logs[left][0];
                serverCount[serverId]--;
                if (serverCount[serverId] == 0) {
                    activeServers--;
                }
                left++;
            }

            // Servers with zero requests
            ans[origIdx] = n - activeServers;
        }

        return ans;
    }
}

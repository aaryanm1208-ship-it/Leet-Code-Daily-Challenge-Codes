import java.util.Arrays;

class Solution {
    public int findTheDistanceValue(int[] arr1, int[] arr2, int d) {
        Arrays.sort(arr2);
        int count = 0;

        for (int x : arr1) {
            if (isValid(arr2, x, d)) {
                count++;
            }
        }
        return count;
    }

    private boolean isValid(int[] arr2, int target, int d) {
        int left = 0, right = arr2.length - 1;

        // Binary search to find if any element falls in [target - d, target + d]
        while (left <= right) {
            int mid = left + (right - left) / 2;

            if (arr2[mid] >= target - d && arr2[mid] <= target + d) {
                return false; // Found an element within distance d
            } else if (arr2[mid] < target - d) {
                left = mid + 1;
            } else {
                right = mid - 1;
            }
        }
        return true;
    }
}

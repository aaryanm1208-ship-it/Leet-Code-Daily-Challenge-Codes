class Solution {
    public long countCommas(long n) {
        long total = 0;

        // Numbers with 4 to 6 digits have 1 comma
        if (n >= 1000) {
            total += n - 999;
        }

        // Numbers with 7 to 9 digits have 2 commas
        if (n >= 1_000_000) {
            total += n - 999_999;
        }

        // Numbers with 10 to 12 digits have 3 commas
        if (n >= 1_000_000_000L) {
            total += n - 999_999_999L;
        }

        // Numbers with 13 to 15 digits have 4 commas
        if (n >= 1_000_000_000_000L) {
            total += n - 999_999_999_999L;
        }

        return total;
    }
}

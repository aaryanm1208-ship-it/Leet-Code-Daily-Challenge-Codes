class Solution {
    public int minOperations(String s) {
        int n = s.length();

        boolean sorted = true;
        char min = 'z';
        char max = 'a';

        for (int i = 0; i < n; i++) {
            char c = s.charAt(i);

            if (i > 0 && c < s.charAt(i - 1)) {
                sorted = false;
            }

            min = (char) Math.min(min, c);
            max = (char) Math.max(max, c);
        }

        if (sorted) return 0;
        if (n == 2) return -1;

        char first = s.charAt(0);
        char last = s.charAt(n - 1);

        if (first == min || last == max) return 1;

        if (first == max && last == min) return 3;

        return 2;
    }
}

class Solution {
    public int closedIsland(int[][] grid) {
        int m = grid.length;
        int n = grid[0].length;

        // Step 1: Invalidate all land connected to boundaries
        for (int r = 0; r < m; r++) {
            if (grid[r][0] == 0) {
                dfs(grid, r, 0, m, n);
            }
            if (grid[r][n - 1] == 0) {
                dfs(grid, r, n - 1, m, n);
            }
        }

        for (int c = 0; c < n; c++) {
            if (grid[0][c] == 0) {
                dfs(grid, 0, c, m, n);
            }
            if (grid[m - 1][c] == 0) {
                dfs(grid, m - 1, c, m, n);
            }
        }

        // Step 2: Count internal closed islands
        int closedIslands = 0;
        for (int r = 1; r < m - 1; r++) {
            for (int c = 1; c < n - 1; c++) {
                if (grid[r][c] == 0) {
                    closedIslands++;
                    dfs(grid, r, c, m, n);
                }
            }
        }

        return closedIslands;
    }

    private void dfs(int[][] grid, int r, int c, int m, int n) {
        // Base condition: out of bounds or water
        if (r < 0 || r >= m || c < 0 || c >= n || grid[r][c] == 1) {
            return;
        }

        // Mark cell as visited by flipping land (0) to water (1)
        grid[r][c] = 1;

        // Explore 4 directions
        dfs(grid, r + 1, c, m, n);
        dfs(grid, r - 1, c, m, n);
        dfs(grid, r, c + 1, m, n);
        dfs(grid, r, c - 1, m, n);
    }
}
